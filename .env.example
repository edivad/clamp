# Copy this file to .env and adjust the values if you want:
#   cp .env.example .env
# Docker Compose reads .env automatically when run from this folder.

# Host ports: change them if 8080/8081 are already busy on your machine.
WEB_PORT=8080
ADMINER_PORT=8081

# MariaDB: database name, application user and passwords.
# Simple values are fine here: this stack runs locally for study only.
MARIADB_DATABASE=clamp
MARIADB_USER=clamp
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
